# Отдельный от .env файл -- в .env лежит MYSQL_PASSWORD, а этот файл
# должен быть читаем sandbox-юзером (zenith-sandbox), которому пароль от
# БД видеть незачем. Свой Discord-бот/токен для Zenith, НЕ тот же, что у
# z2r_test-voice-bot -- два процесса с одним токеном одновременно на
# gateway рвут сессию друг другу.
#
#   cp voice.env.example voice.env
#   chown root:zenith-sandbox voice.env && chmod 640 voice.env
#
# GUILD_ID и VOICE_CHANNEL_ID -- те же, что уже в z2r_test-voice-bot/.env
# (тот же тестовый канал, пересоздавать не нужно).

ZENITH_DISCORD_TOKEN=
ZENITH_GUILD_ID=
ZENITH_VOICE_CHANNEL_ID=
ZENITH_VOICE_HOLD_SECONDS=5
ZENITH_VOICE_CONNECT_TIMEOUT=10
