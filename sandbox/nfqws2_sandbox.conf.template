# Шаблон конфига песочного nfqws2 — читается через `@file`, поэтому здесь
# должен быть ПОЛНЫЙ набор флагов (при `@file` все остальные аргументы
# командной строки игнорируются, частичным конфиг быть не может).
#
# __QNUM__ подставляется скриптом start_sandbox.sh из sandbox/queue_num
# (создаётся setup_sandbox.sh). Строку --lua-desync= ниже перезаписывает
# оркестратор перед каждым тестом одного генома — остальное не трогает.
#
# --user=nobody — это про то, каким uid работает САМ nfqws2 после
# привязки к очереди (сброс привилегий, как и в боевом zapret2), не про
# то, чей трафик перехватывается — это уже решает iptables-правило из
# setup_sandbox.sh (owner-match по zenith-sandbox).

--qnum=__QNUM__
--user=nobody
--daemon
--pidfile=__ZENITH_DIR__/sandbox/nfqws2_sandbox.pid
--debug=@__ZENITH_DIR__/sandbox/nfqws2_sandbox.debug.log

--filter-tcp=443 --filter-l7=tls
--lua-desync=fake:blob=fake_default_tls:ip_ttl=6
