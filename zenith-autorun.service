[Unit]
Description=Zenith periodic candidate generation (orchestrator/main.py on a rotating schedule)
After=network-online.target docker.service
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# после отключения света: дождаться локальной MySQL (на нодах с ZENITH_DB_MODE=api сразу выходит)
ExecStartPre=/opt/z2r_autobench/Zenith/wait_zenith_db.sh
TimeoutStartSec=360
Type=simple
WorkingDirectory=/opt/z2r_autobench/Zenith
ExecStart=/usr/bin/bash /opt/z2r_autobench/Zenith/zenith_autorun.sh
Restart=on-failure
RestartSec=30
User=root
StandardOutput=journal
StandardError=journal

# Переопределить настройки можно тут, например:
# Environment=ZENITH_AUTORUN_INTERVAL_MINUTES=120
# Environment=ZENITH_AUTORUN_ROUNDS=30

[Install]
WantedBy=multi-user.target
