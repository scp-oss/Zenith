# Скопируй в /etc/caddy/Caddyfile на боевом сервере, замени PANEL_HOSTNAME
# и PANEL_PUBLIC_PORT на реальные (см. README "Публикация панели через
# Cloudflare"). Сертификат -- Cloudflare Origin CA (генерится в дашборде
# Cloudflare, SSL/TLS -> Origin Server -> Create Certificate), НЕ
# Let's Encrypt -- порт 80/443 для ACME-челленджа на хосте обычно занят,
# Origin CA сертификат выпускается вручную в дашборде, без челленджа
# вообще. Cloudflare должен быть в режиме Full (strict), иначе он не
# примет этот сертификат от origin.
PANEL_HOSTNAME:PANEL_PUBLIC_PORT {
	tls /etc/caddy/cf-origin.pem /etc/caddy/cf-origin-key.pem

	reverse_proxy 127.0.0.1:8766
}
