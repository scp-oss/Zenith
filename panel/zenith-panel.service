[Unit]
Description=Zenith web panel (dashboard + node sync API)
After=network.target mysql.service

[Service]
Type=simple
User=zenith-panel
WorkingDirectory=/opt/z2r_autobench/Zenith/panel
ExecStart=/opt/z2r_autobench/Zenith/panel/run.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
