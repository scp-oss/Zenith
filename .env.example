# Скопируй в .env и поменяй значения перед первым запуском.
#
# Три режима работы с БД на этой ноде (см. README "Три режима БД"):
#   1) ZENITH_DB_MODE=docker, без PANEL_URL      -- локальная БД, изолированная нода, панели не видно.
#   2) ZENITH_DB_MODE=docker, + PANEL_URL/TOKEN  -- локальная БД + hub-and-spoke sync с панелью (обычный выбор для новой ноды).
#   3) ZENITH_DB_MODE=external, MYSQL_HOST=<central> -- своей БД нет вообще, все таблицы общие с центральным
#      сервером напрямую (см. db/create_remote_db_user.sh -- выполняется НА ЦЕНТРАЛЬНОМ сервере,
#      создаёт урезанного юзера под конкретный IP этой ноды). PANEL_URL/TOKEN тут не нужны --
#      sync и так происходит бесплатно через общие таблицы, HTTP не участвует.
ZENITH_DB_MODE=docker

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=z2r_genome
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=zenith
MYSQL_PASSWORD=change-me-app
# Только для ZENITH_DB_MODE=docker на ЦЕНТРАЛЬНОМ сервере, если планируешь
# режим 3 для каких-то нод -- на каком интерфейсе слушает порт MySQL
# наружу (НЕ то же самое, что MYSQL_HOST выше -- тот для подключения
# ИЗНУТРИ этого же сервера, не трогай). 0.0.0.0 -- ОБЯЗАТЕЛЬНО вместе с
# db/mysql_node_allowlist.sh, иначе порт открыт всему интернету.
# MYSQL_BIND_HOST=0.0.0.0

# VOICE_UDP -- никакого своего Discord-токена не нужно: Zenith дёргает
# уже работающий и залогиненный z2r_test-voice-bot через его локальный
# HTTP (см. z2r_test-voice-bot/README.md "Интеграция с Zenith"). Один
# бот, один токен, один владелец -- бот должен быть настроен и запущен
# отдельно (свой репозиторий). Обычно дефолт ниже подходит без изменений.
# ZENITH_PROBE_URL=http://127.0.0.1:8765/probe

# --- Эта нода/окружение (используется main.py/bootstrap.py/sync_client.py/
# compare_control.py/promote.py как дефолт --environment/--provider, и
# self-report на панель в режиме 2 -- см. orchestrator/config.py) ---
ZENITH_ENVIRONMENT_NAME=prod-domru
ZENITH_ENVIRONMENT_PROVIDER=domru

# --- Режим 2 (hub-and-spoke): sync_client.py/bootstrap.py, ТОЛЬКО на
# удалённых нодах -- локальная прод-нода панель не спрашивает, она и так
# видит её же БД напрямую. Токен -- на панели, /nodes -> "Создать токен"
# (создаётся ПУСТЫМ, имя/провайдера нода сообщает сама -- см. выше). ---
# PANEL_URL=https://<хост-панели>:<альт-порт Cloudflare>
# PANEL_NODE_TOKEN=

# --- Веб-панель -- ОТДЕЛЬНЫЙ репозиторий, scp-oss/z0r-panel, со своим
# .env (не этим) -- см. его README. ---
