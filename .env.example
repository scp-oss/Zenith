# Скопируй в .env и поменяй значения перед первым запуском.
#
# ZENITH_DB_MODE=docker   — поднимаем MySQL сами через docker-compose (по умолчанию).
# ZENITH_DB_MODE=external — подключаемся к уже существующей БД, docker для неё не нужен;
#                           заполни MYSQL_HOST/MYSQL_PORT под неё.
ZENITH_DB_MODE=docker

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=z2r_genome
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=zenith
MYSQL_PASSWORD=change-me-app

# VOICE_UDP -- никакого своего Discord-токена не нужно: Zenith дёргает
# уже работающий и залогиненный z2r_test-voice-bot через его локальный
# HTTP (см. z2r_test-voice-bot/README.md "Интеграция с Zenith"). Один
# бот, один токен, один владелец -- бот должен быть настроен и запущен
# отдельно (свой репозиторий). Обычно дефолт ниже подходит без изменений.
# ZENITH_PROBE_URL=http://127.0.0.1:8765/probe
