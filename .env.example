# Скопируй в .env и поменяй значения перед первым запуском.
#
# ZENITH_DB_MODE=docker   — поднимаем MySQL сами через docker-compose (по умолчанию).
# ZENITH_DB_MODE=external — подключаемся к уже существующей БД, docker для неё не нужен;
#                           заполни MYSQL_HOST/MYSQL_PORT под неё.
ZENITH_DB_MODE=docker

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=z2r_genome
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=zenith
MYSQL_PASSWORD=change-me-app

# VOICE_UDP -- никакого своего Discord-токена не нужно: Zenith дёргает
# уже работающий и залогиненный z2r_test-voice-bot через его локальный
# HTTP (см. z2r_test-voice-bot/README.md "Интеграция с Zenith"). Один
# бот, один токен, один владелец -- бот должен быть настроен и запущен
# отдельно (свой репозиторий). Обычно дефолт ниже подходит без изменений.
# ZENITH_PROBE_URL=http://127.0.0.1:8765/probe

# --- Эта нода/окружение (используется и main.py, и panel/, и sync_client.py) ---
ZENITH_ENVIRONMENT_NAME=prod-domru
ZENITH_ENVIRONMENT_PROVIDER=domru

# --- panel/ (веб-панель: обзор по нодам, история мутаций, sync-хаб) ---
# Логин см. panel/gen_password_hash.py -- сам пароль в .env НЕ хранится,
# только pbkdf2-хэш.
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD_HASH=
# Сгенерировать: python3 -c 'import secrets; print(secrets.token_hex(32))'
PANEL_SESSION_SECRET=
PANEL_HOST=0.0.0.0
PANEL_PORT=8766
# Путь к z2r_autobench (для set_strategy_cli.sh, read-only get/max на
# странице /controls) -- дефолт подходит, если Zenith лежит рядом
# (/opt/z2r_autobench/Zenith), меняй только при нестандартной раскладке.
# Z2R_AUTOBENCH_DIR=/opt/z2r_autobench

# --- sync_client.py / bootstrap.py (ТОЛЬКО на удалённых нодах, не на самой
# панели -- локальная прод-нода пишет в БД панели напрямую, без HTTP) ---
# Выдаётся на панели (/nodes -> "Добавить ноду"), показывается один раз.
# PANEL_URL=http://<адрес-панели>:8766
# PANEL_NODE_TOKEN=
