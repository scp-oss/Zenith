# Скопируй в .env и поменяй значения перед первым запуском.
#
# Два режима работы с БД на этой ноде (см. README "Два режима БД"):
#   1) ZENITH_DB_MODE=docker, без PANEL_URL      -- локальная БД, изолированная нода, панели не видно.
#   2) ZENITH_DB_MODE=docker, + PANEL_URL/TOKEN  -- локальная БД (буфер) + hub-and-spoke sync с панелью (обычный выбор для новой ноды).
#   3) ZENITH_DB_MODE=api, + PANEL_URL/TOKEN     -- своей БД нет вообще (не нужен даже Docker), каждый вызов
#      db.py -- HTTP-запрос к панели тем же PANEL_URL/TOKEN, что и режим 2. MySQL-порт наружу
#      не открывается НИ В ОДНОМ режиме -- см. db_api.py.
ZENITH_DB_MODE=docker

# Только для ZENITH_DB_MODE=docker -- откуда берётся сама MySQL/MariaDB:
#   docker  (по умолчанию) -- поднимается через docker-compose.yml (mysql:8.4),
#           z0r управляет её жизненным циклом (Zenith > Запуск/Стоп).
#   native  -- уже установлена в систему пакетом (mariadb-server/mysql-server),
#           поднята и настроена отдельно (см. db/schema.sql + db/migrations/).
#           z0r Docker вообще не трогает -- статус/старт-стоп идут через
#           systemctl (mariadb.service), см. README "Нативная БД вместо Docker".
ZENITH_DB_BACKEND=docker

# Только для ZENITH_DB_MODE=docker.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=z2r_genome
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=zenith
MYSQL_PASSWORD=change-me-app

# VOICE_UDP -- никакого своего Discord-токена не нужно: Zenith дёргает
# уже работающий и залогиненный z2r_test-voice-bot через его локальный
# HTTP (см. z2r_test-voice-bot/README.md "Интеграция с Zenith"). Один
# бот, один токен, один владелец -- бот должен быть настроен и запущен
# отдельно (свой репозиторий). Обычно дефолт ниже подходит без изменений.
# ZENITH_PROBE_URL=http://127.0.0.1:8765/probe

# --- Эта нода/окружение (используется main.py/bootstrap.py/sync_client.py/
# compare_control.py/promote.py как дефолт --environment/--provider, и
# self-report на панель в режимах 2/3 -- см. orchestrator/config.py) ---
ZENITH_ENVIRONMENT_NAME=prod-domru
ZENITH_ENVIRONMENT_PROVIDER=domru

# --- Режимы 2 (hub-and-spoke sync) и 3 (api, без своей БД) -- ОДИН и тот
# же PANEL_URL/TOKEN для обоих, ТОЛЬКО на удалённых нодах -- локальная
# прод-нода панель не спрашивает, она и так видит её же БД напрямую.
# Токен -- на панели, /nodes -> "Создать токен" (создаётся ПУСТЫМ,
# имя/провайдера нода сообщает сама -- см. выше). ---
# PANEL_URL=https://<хост-панели>:<альт-порт Cloudflare>
# PANEL_NODE_TOKEN=

# --- Веб-панель -- ОТДЕЛЬНЫЙ репозиторий, scp-oss/z0r-panel, со своим
# .env (не этим) -- см. его README. ---

# --- Только для auto_promoter.py (см. README "Автономный режим") --
# дефолты подходят при стандартной раскладке ($INSTALL_DIR/Zenith рядом
# с $INSTALL_DIR/z2r_autobench), меняй только при нестандартной. ---
# Z2R_AUTOBENCH_DIR=/opt/z2r_autobench
# ZAPRET2_CONFIG_PATH=/opt/zapret2/config
# PROMOTE_BACKUP_DIR=/opt/zapret2/config_backups
