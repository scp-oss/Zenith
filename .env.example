# Скопируй в .env и поменяй значения перед первым запуском.
#
# ZENITH_DB_MODE=docker   — поднимаем MySQL сами через docker-compose (по умолчанию).
# ZENITH_DB_MODE=external — подключаемся к уже существующей БД, docker для неё не нужен;
#                           заполни MYSQL_HOST/MYSQL_PORT под неё.
ZENITH_DB_MODE=docker

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=z2r_genome
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=zenith
MYSQL_PASSWORD=change-me-app

# VOICE_UDP -- отдельный Discord-бот/токен, НЕ тот же, что у
# z2r_test-voice-bot (два процесса с одним токеном на gateway рвут сессию
# друг другу). GUILD_ID/VOICE_CHANNEL_ID -- те же, что уже в
# z2r_test-voice-bot/.env (тот же тестовый канал, пересоздавать не нужно).
# ВНИМАНИЕ: .env целиком читает zenith-sandbox (voice_probe.py запускается
# от его имени) -- MYSQL_PASSWORD выше тоже становится ему видимым.
ZENITH_DISCORD_TOKEN=
ZENITH_GUILD_ID=
ZENITH_VOICE_CHANNEL_ID=
ZENITH_VOICE_HOLD_SECONDS=5
ZENITH_VOICE_CONNECT_TIMEOUT=10
